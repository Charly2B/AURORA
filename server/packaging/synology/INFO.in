package="aurora"
version="@VERSION@-@BUILD@"
os_min_ver="7.0-40000"
displayname="AURORA"
description="Personal media center: organize and play your movies and TV shows from your browser. Runs natively, no Docker, no cloud account."
description_fre="Médiathèque personnelle : organisez et regardez vos films et séries depuis votre navigateur. Installation native, sans Docker ni compte en ligne."
displayname_fre="AURORA"
arch="x86_64 v1000 v1000nk"
maintainer="AURORA (usage personnel)"
dsmuidir="ui"
dsmappname="com.aurora.mediacenter"
adminprotocol="http"
adminport="8890"
adminurl="/"
checkport="yes"
ctl_stop="yes"
precheckstartstop="no"
thirdparty="yes"
silent_install="no"
silent_upgrade="no"
silent_uninstall="no"
checksum="@CHECKSUM@"
extractsize="@EXTRACTSIZE@"
